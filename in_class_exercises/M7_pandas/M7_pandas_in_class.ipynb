   "source": [
    "## 11. Answer the question: health by borough (slide 44)\n",
    "With a partner, write a comment on each line of the function before you run it. What does `.where` do on the first line?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b91dc5b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def tree_health_by_boro(trees):\n",
    "    combined_status = trees.status.where(trees.status != \"Alive\", trees.health)\n",
    "    num_per_boro = trees.groupby(\"borough\").size()\n",
    "    combined_per_boro = trees.groupby([\"borough\", combined_status]).size()\n",
    "    pct_per_boro = combined_per_boro / num_per_boro * 100.0\n",
    "    pct_per_boro_df = pct_per_boro.unstack()\n",
    "    return pct_per_boro_df[[\"Good\", \"Fair\", \"Poor\", \"Dead\", \"Stump\"]]\n",
    "\n",
    "tree_health_by_boro(trees).round(1)"
   ]
  },
